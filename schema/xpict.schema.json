{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DepictSpec",
  "description": "Declarative document (`mol`, `group`, or `reaction_scheme` root).",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "align_to": {
          "anyOf": [
            {
              "$ref": "#/definitions/AlignTo"
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "cxsmiles": {
          "type": [
            "string",
            "null"
          ]
        },
        "halo": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "molfile": {
          "type": [
            "string",
            "null"
          ]
        },
        "opts": {
          "anyOf": [
            {
              "$ref": "#/definitions/Opts"
            },
            {
              "type": "null"
            }
          ]
        },
        "scale": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "shade": {
          "anyOf": [
            {
              "$ref": "#/definitions/ShadeSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "smiles": {
          "type": [
            "string",
            "null"
          ]
        },
        "star_labels": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": {
          "type": "string",
          "enum": [
            "mol"
          ]
        },
        "weight": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "align": {
          "description": "When true, later children align onto the first (or each `align_to`).",
          "default": false,
          "type": "boolean"
        },
        "children": {
          "description": "Child mols only (no edges).",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/MolNode"
          }
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "opts": {
          "description": "Group-level cascade bag (list container for child inheritance).",
          "anyOf": [
            {
              "$ref": "#/definitions/Opts"
            },
            {
              "type": "null"
            }
          ]
        },
        "scale": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "type": {
          "type": "string",
          "enum": [
            "group"
          ]
        }
      }
    },
    {
      "description": "Reaction / pathway scheme: mixed **node** children (`mol` | `edge`).",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "children": {
          "description": "Child **nodes** — mols and edges interleaved (or any order).",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/Node"
          }
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "opts": {
          "description": "Scheme-level cascade bag for child mol inheritance.",
          "anyOf": [
            {
              "$ref": "#/definitions/Opts"
            },
            {
              "type": "null"
            }
          ]
        },
        "scale": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "type": {
          "type": "string",
          "enum": [
            "reaction_scheme"
          ]
        }
      }
    }
  ],
  "definitions": {
    "AlignTo": {
      "description": "Document align target: id string or `{ \"ref\", \"atom_map\"?, \"min_atoms\"? }`.",
      "anyOf": [
        {
          "description": "Shorthand for `{ \"ref\": \"…\" }`.",
          "type": "string"
        },
        {
          "$ref": "#/definitions/AlignToSpec"
        }
      ]
    },
    "AlignToSpec": {
      "description": "Object form of document ``align_to`` (template ref + EdgePlan-style opts).",
      "type": "object",
      "required": [
        "ref"
      ],
      "properties": {
        "atom_map": {
          "description": "Pairs `(query, template)` vs the template; skips MCS when set.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": [
              {
                "type": "integer",
                "format": "uint32",
                "minimum": 0.0
              },
              {
                "type": "integer",
                "format": "uint32",
                "minimum": 0.0
              }
            ],
            "maxItems": 2,
            "minItems": 2
          }
        },
        "min_atoms": {
          "description": "Override [`crate::edge::MIN_MCS_ATOMS`] when set.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "ref": {
          "description": "Id of the template mol in this group.",
          "type": "string"
        }
      }
    },
    "CommonOpts": {
      "description": "Universal cascading keys (any node kind).",
      "type": "object",
      "properties": {
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "scale": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "EdgeArrow": {
      "description": "Arrow head / shaft style for diagram edges.",
      "oneOf": [
        {
          "description": "Single →",
          "type": "string",
          "enum": [
            "forward"
          ]
        },
        {
          "description": "⇌ stacked half-arrows",
          "type": "string",
          "enum": [
            "equilibrium"
          ]
        },
        {
          "description": "⇒ hollow head (retrosynthetic-style)",
          "type": "string",
          "enum": [
            "open"
          ]
        },
        {
          "description": "Connector without arrowhead",
          "type": "string",
          "enum": [
            "line"
          ]
        }
      ]
    },
    "EdgeNode": {
      "description": "Edge **node** — a reaction / network link between mol ids.\n\nLives in container `children` alongside [`MolNode`] (see [`Node`]).",
      "type": "object",
      "required": [
        "source",
        "target",
        "type"
      ],
      "properties": {
        "arrow": {
          "default": "forward",
          "allOf": [
            {
              "$ref": "#/definitions/EdgeArrow"
            }
          ]
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "dashed": {
          "default": false,
          "type": "boolean"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "description": "Optional semantic role (e.g. enzyme) — not drawn by default.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "Id of the source mol node.",
          "type": "string"
        },
        "stroke_width": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "target": {
          "description": "Id of the target mol node.",
          "type": "string"
        },
        "type": {
          "description": "Wire discriminant — required so untagged [`Node`] does not absorb edges as mols.",
          "allOf": [
            {
              "$ref": "#/definitions/EdgeNodeKind"
            }
          ]
        }
      }
    },
    "EdgeNodeKind": {
      "description": "Discriminator for edge nodes (`\"type\": \"edge\"`).",
      "type": "string",
      "enum": [
        "edge"
      ]
    },
    "ForTypesPatch": {
      "description": "Multi-kind patch: `{ \"for_types\": [\"mol\",\"group\"], …common opts }`.\n\nOnly [`CommonOpts`] keys are allowed here (intersection of kind bags).",
      "type": "object",
      "required": [
        "for_types"
      ],
      "properties": {
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "for_types": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NodeType"
          }
        },
        "scale": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "MolNode": {
      "description": "Mol node — [`MolOpts`] fields + non-cascading identity / scores / align.",
      "type": "object",
      "properties": {
        "align_to": {
          "description": "Template id string, or `{ \"ref\", \"atom_map\"?, \"min_atoms\"? }`.",
          "anyOf": [
            {
              "$ref": "#/definitions/AlignTo"
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "cxsmiles": {
          "type": [
            "string",
            "null"
          ]
        },
        "halo": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "molfile": {
          "type": [
            "string",
            "null"
          ]
        },
        "opts": {
          "description": "Cascade patches for this node (list or singleton).",
          "anyOf": [
            {
              "$ref": "#/definitions/Opts"
            },
            {
              "type": "null"
            }
          ]
        },
        "scale": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "shade": {
          "description": "Shade **scores** (+ legacy window); window also cascades via [`Opts`].",
          "anyOf": [
            {
              "$ref": "#/definitions/ShadeSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "smiles": {
          "type": [
            "string",
            "null"
          ]
        },
        "star_labels": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": {
          "default": "mol",
          "allOf": [
            {
              "$ref": "#/definitions/MolNodeKind"
            }
          ]
        },
        "weight": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "MolNodeKind": {
      "description": "Discriminator for mol nodes (`\"type\": \"mol\"`).",
      "type": "string",
      "enum": [
        "mol"
      ]
    },
    "Node": {
      "description": "Document **node** in a reaction scheme: mol or edge.\n\nUntagged so each variant keeps its own `\"type\"` field ([`MolNode`] / [`EdgeNode`]). Group containers stay mol-only ([`Vec<MolNode>`]).",
      "anyOf": [
        {
          "$ref": "#/definitions/MolNode"
        },
        {
          "$ref": "#/definitions/EdgeNode"
        }
      ]
    },
    "NodeType": {
      "description": "Document node kinds opts may target (matches wire `\"type\"` discriminants).",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "mol",
            "group"
          ]
        },
        {
          "description": "Multi-mol scheme with edge nodes in `children` (`\"type\": \"reaction_scheme\"`).",
          "type": "string",
          "enum": [
            "reaction_scheme"
          ]
        },
        {
          "description": "Edge / reaction link node (`\"type\": \"edge\"`).",
          "type": "string",
          "enum": [
            "edge"
          ]
        }
      ]
    },
    "Opts": {
      "description": "Cascade bag: singleton patch or list of patches.",
      "anyOf": [
        {
          "$ref": "#/definitions/OptsPatch"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OptsPatch"
          }
        }
      ]
    },
    "OptsPatch": {
      "description": "One cascade rule. Untagged order: typed → for_types → universal.",
      "anyOf": [
        {
          "description": "`{ \"type\": \"mol\", \"weight\": 1.2 }` — discriminated kind.",
          "allOf": [
            {
              "$ref": "#/definitions/TypedOptsPatch"
            }
          ]
        },
        {
          "description": "`{ \"for_types\": [\"mol\",\"group\"], \"color\": \"#111\" }`.",
          "allOf": [
            {
              "$ref": "#/definitions/ForTypesPatch"
            }
          ]
        },
        {
          "description": "`{ \"color\": \"#111\" }` — applies to every kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CommonOpts"
            }
          ]
        }
      ]
    },
    "ShadeSpec": {
      "description": "Per-atom / per-bond colormap scores (+ legacy window fields on the mol).\n\nPrefer putting `colormap` / `vmin` / `vmax` in cascading [`MolOpts::shade`]; values here still apply as local leaf overrides for compat.",
      "type": "object",
      "properties": {
        "atoms": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "bonds": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "colormap": {
          "type": [
            "string",
            "null"
          ]
        },
        "vmax": {
          "default": 1.0,
          "type": "number",
          "format": "double"
        },
        "vmin": {
          "default": 0.0,
          "type": "number",
          "format": "double"
        }
      }
    },
    "ShadeStyle": {
      "description": "Cascading shade window / LUT (not per-atom scores).",
      "type": "object",
      "properties": {
        "colormap": {
          "type": [
            "string",
            "null"
          ]
        },
        "vmax": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "vmin": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "TypedOptsPatch": {
      "description": "Discriminated opts patch: `{ \"type\": \"mol\"|\"group\"|\"reaction_scheme\"|\"edge\", …opts }`.",
      "oneOf": [
        {
          "description": "Mol cascading paint opts — what a mol leaf consumes from the cascade.\n\n[`MolNode`] carries the same fields at the top level (local leaf opts) plus non-cascading identity keys.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "color": {
              "type": [
                "string",
                "null"
              ]
            },
            "halo": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "scale": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "shade": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ShadeStyle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "mol"
              ]
            },
            "weight": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            }
          }
        },
        {
          "description": "Universal cascading keys (any node kind).",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "color": {
              "type": [
                "string",
                "null"
              ]
            },
            "scale": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "type": {
              "type": "string",
              "enum": [
                "group"
              ]
            }
          }
        },
        {
          "description": "Universal cascading keys (any node kind).",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "color": {
              "type": [
                "string",
                "null"
              ]
            },
            "scale": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "type": {
              "type": "string",
              "enum": [
                "reaction_scheme"
              ]
            }
          }
        },
        {
          "description": "Universal cascading keys (any node kind).",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "color": {
              "type": [
                "string",
                "null"
              ]
            },
            "scale": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "type": {
              "type": "string",
              "enum": [
                "edge"
              ]
            }
          }
        }
      ]
    }
  }
}
