{
  "$defs": {
    "GroupNode": {
      "additionalProperties": false,
      "description": "Live group \u2014 subset of future ``GroupNode`` (mol children only today).",
      "properties": {
        "type": {
          "const": "group",
          "default": "group",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional stable id",
          "title": "Id"
        },
        "children": {
          "description": "Owned mol nodes (discriminated by ``type``)",
          "items": {
            "$ref": "#/$defs/MolNode"
          },
          "title": "Children",
          "type": "array"
        }
      },
      "title": "GroupNode",
      "type": "object"
    },
    "MolNode": {
      "additionalProperties": false,
      "description": "Live molecule node \u2014 subset of future ``MolNode`` / ``MoleculeSpec``.",
      "properties": {
        "type": {
          "const": "mol",
          "default": "mol",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional stable id",
          "title": "Id"
        },
        "smiles": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SMILES string",
          "title": "Smiles"
        },
        "cxsmiles": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ChemAxon extended SMILES (CXSMILES)",
          "title": "Cxsmiles"
        },
        "molfile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MDL molblock",
          "title": "Molfile"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ink color for backbone bonds and atom labels (CSS)",
          "title": "Color"
        },
        "shade": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShadeSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-atom / per-bond colormap scores"
        },
        "rgroups": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Labels for ``*`` atoms (encounter order list, or ordinal dict). Use chem markup for scripts: ``R_{1}`` or ``$R_1$``.",
          "title": "Rgroups"
        }
      },
      "title": "MolNode",
      "type": "object"
    },
    "ShadeSpec": {
      "additionalProperties": false,
      "description": "Continuous per-atom / per-bond scores for colormap shading.",
      "properties": {
        "atoms": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-atom scores (same length as atom count)",
          "title": "Atoms"
        },
        "bonds": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-bond scores",
          "title": "Bonds"
        },
        "colormap": {
          "default": "xenosite",
          "description": "Named colormap",
          "title": "Colormap",
          "type": "string"
        },
        "vmin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vmin"
        },
        "vmax": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vmax"
        }
      },
      "title": "ShadeSpec",
      "type": "object"
    }
  },
  "description": "Preferred declarative document (strict subset of future PictSpec).",
  "discriminator": {
    "mapping": {
      "group": "#/$defs/GroupNode",
      "mol": "#/$defs/MolNode"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/MolNode"
    },
    {
      "$ref": "#/$defs/GroupNode"
    }
  ],
  "title": "DepictSpec"
}
