{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DepictSpec",
  "description": "Declarative document (`mol`, `group`, or `reaction_scheme` root).",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "align_to": {
          "anyOf": [
            {
              "$ref": "#/definitions/AlignTo"
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "cxsmiles": {
          "type": [
            "string",
            "null"
          ]
        },
        "halo": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "description": "Caption: [`Label`] (string id / list / `{id, pos?}` — text-node refs).",
          "anyOf": [
            {
              "$ref": "#/definitions/Label"
            },
            {
              "type": "null"
            }
          ]
        },
        "molfile": {
          "type": [
            "string",
            "null"
          ]
        },
        "opts": {
          "anyOf": [
            {
              "$ref": "#/definitions/Opts"
            },
            {
              "type": "null"
            }
          ]
        },
        "scale": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "shade": {
          "anyOf": [
            {
              "$ref": "#/definitions/ShadeSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "smiles": {
          "type": [
            "string",
            "null"
          ]
        },
        "star_labels": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": {
          "type": "string",
          "enum": [
            "mol"
          ]
        },
        "weight": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "align": {
          "description": "When true, later children align onto the first (or each `align_to`).",
          "default": false,
          "type": "boolean"
        },
        "children": {
          "description": "Child **nodes** — mol | text (no edges).",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/Node"
          }
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "opts": {
          "description": "Group-level cascade bag (list container for child inheritance).",
          "anyOf": [
            {
              "$ref": "#/definitions/Opts"
            },
            {
              "type": "null"
            }
          ]
        },
        "scale": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "type": {
          "type": "string",
          "enum": [
            "group"
          ]
        }
      }
    },
    {
      "description": "Reaction / pathway scheme: mixed **node** children (`mol` | `edge` | `text`).\n\nLayout defaults to **ELK layered** ([`LayoutOpts`] / [`reaction_elk_defaults`]).",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "children": {
          "description": "Child **nodes** — mols, edges, and text (any order).",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/Node"
          }
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "layout": {
          "description": "ELK layout (defaults applied when omitted).",
          "anyOf": [
            {
              "$ref": "#/definitions/LayoutOpts"
            },
            {
              "type": "null"
            }
          ]
        },
        "opts": {
          "description": "Scheme-level cascade bag for child mol inheritance.",
          "anyOf": [
            {
              "$ref": "#/definitions/Opts"
            },
            {
              "type": "null"
            }
          ]
        },
        "scale": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "type": {
          "type": "string",
          "enum": [
            "reaction_scheme"
          ]
        }
      }
    }
  ],
  "definitions": {
    "AlignTo": {
      "description": "Document align target: id string or `{ \"ref\", \"atom_map\"?, \"min_atoms\"? }`.",
      "anyOf": [
        {
          "description": "Shorthand for `{ \"ref\": \"…\" }`.",
          "type": "string"
        },
        {
          "$ref": "#/definitions/AlignToSpec"
        }
      ]
    },
    "AlignToSpec": {
      "description": "Object form of document ``align_to`` (template ref + EdgePlan-style opts).",
      "type": "object",
      "required": [
        "ref"
      ],
      "properties": {
        "atom_map": {
          "description": "Pairs `(query, template)` vs the template; skips MCS when set.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": [
              {
                "type": "integer",
                "format": "uint32",
                "minimum": 0.0
              },
              {
                "type": "integer",
                "format": "uint32",
                "minimum": 0.0
              }
            ],
            "maxItems": 2,
            "minItems": 2
          }
        },
        "min_atoms": {
          "description": "Override [`crate::edge::MIN_MCS_ATOMS`] when set.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "ref": {
          "description": "Id of the template mol in this group.",
          "type": "string"
        }
      }
    },
    "CommonOpts": {
      "description": "Universal cascading keys (any node kind).",
      "type": "object",
      "properties": {
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "scale": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "EdgeArrow": {
      "description": "Arrow head / shaft style for diagram edges.",
      "oneOf": [
        {
          "description": "Single →",
          "type": "string",
          "enum": [
            "forward"
          ]
        },
        {
          "description": "⇌ stacked half-arrows",
          "type": "string",
          "enum": [
            "equilibrium"
          ]
        },
        {
          "description": "⇒ hollow head (retrosynthetic-style)",
          "type": "string",
          "enum": [
            "open"
          ]
        },
        {
          "description": "Connector without arrowhead",
          "type": "string",
          "enum": [
            "line"
          ]
        }
      ]
    },
    "EdgeNode": {
      "description": "Edge **node** — a reaction / network link between mol ids.\n\nLabel chrome refs sibling text/mol nodes via [`Self::label`] (string, list, placed object, or lane object — see [`Label`]).",
      "type": "object",
      "required": [
        "source",
        "target",
        "type"
      ],
      "properties": {
        "arrow": {
          "default": "forward",
          "allOf": [
            {
              "$ref": "#/definitions/EdgeArrow"
            }
          ]
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "dashed": {
          "default": false,
          "type": "boolean"
        },
        "label": {
          "description": "Label chrome: id / list / `{id, pos?}` / `{above,below,left,right}`.",
          "anyOf": [
            {
              "$ref": "#/definitions/Label"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "description": "Optional semantic role (e.g. enzyme) — not drawn by default.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "Id of the source mol node.",
          "type": "string"
        },
        "stroke_width": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "target": {
          "description": "Id of the target mol node.",
          "type": "string"
        },
        "type": {
          "description": "Wire discriminant — required so untagged [`Node`] does not absorb edges as mols.",
          "allOf": [
            {
              "$ref": "#/definitions/EdgeNodeKind"
            }
          ]
        }
      }
    },
    "EdgeNodeKind": {
      "description": "Discriminator for edge nodes (`\"type\": \"edge\"`).",
      "type": "string",
      "enum": [
        "edge"
      ]
    },
    "ElkDirection": {
      "description": "Flow direction for ELK layered layout (`elk.direction`).",
      "type": "string",
      "enum": [
        "RIGHT",
        "LEFT",
        "UP",
        "DOWN"
      ]
    },
    "ElkEdgeRouting": {
      "description": "Edge routing style (`elk.edgeRouting`).",
      "type": "string",
      "enum": [
        "ORTHOGONAL",
        "POLYLINE",
        "SPLINES"
      ]
    },
    "ForTypesPatch": {
      "description": "Multi-kind patch: `{ \"for_types\": [\"mol\",\"group\"], …common opts }`.\n\nOnly [`CommonOpts`] keys are allowed here (intersection of kind bags).",
      "type": "object",
      "required": [
        "for_types"
      ],
      "properties": {
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "for_types": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NodeType"
          }
        },
        "scale": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "Label": {
      "description": "Unified label: string id, list, placed object, or lane object.\n\n```json \"label\": \"adh\" \"label\": [\"adh\", {\"id\": \"rt\", \"pos\": \"below\"}] \"label\": { \"id\": \"adh\", \"pos\": \"left\" } \"label\": { \"above\": [\"adh\"], \"below\": [\"rt\"], \"left\": [\"nabh4\"] } ```",
      "anyOf": [
        {
          "description": "Bare node id (default position: above).",
          "type": "string"
        },
        {
          "description": "Ordered list of ids / placements.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/LabelItem"
          }
        },
        {
          "description": "Single placement with optional `pos`.",
          "allOf": [
            {
              "$ref": "#/definitions/LabelPlacement"
            }
          ]
        },
        {
          "description": "Explicit above / below / left / right id lists.",
          "allOf": [
            {
              "$ref": "#/definitions/LabelLanes"
            }
          ]
        }
      ]
    },
    "LabelItem": {
      "description": "One entry in a label list: bare id or `{ id, pos? }`.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/LabelPlacement"
        }
      ]
    },
    "LabelLanes": {
      "description": "Lane bag: `{ \"above\": [...], \"below\": [...], \"left\": [...], \"right\": [...] }`.",
      "type": "object",
      "properties": {
        "above": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "below": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "left": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "right": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "LabelPlacement": {
      "description": "Placed label: `{ \"id\": \"adh\", \"pos\": \"below\" }` (`pos` optional → above).",
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "description": "Id of a [`TextNode`] or (on edges) [`MolNode`].",
          "type": "string"
        },
        "pos": {
          "anyOf": [
            {
              "$ref": "#/definitions/LabelPos"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "LabelPos": {
      "description": "Side of an edge shaft (or mol caption) for a label placement.",
      "type": "string",
      "enum": [
        "above",
        "below",
        "left",
        "right"
      ]
    },
    "LayoutOpts": {
      "description": "Layout for [`DepictSpec::ReactionScheme`] — **ELK layered by default**.\n\nFirst-class fields cover the knobs we actually tune for pathways; everything else passes through [`Self::elk_options`] as stringy ELK keys (same as future `diagram.elk_options`).\n\n# Defaults (reaction)\n\n| Key | Value | Role | | --- | --- | --- | | `elk.algorithm` | `layered` | Sugiyama layers for pathways | | `elk.direction` | `RIGHT` | Left→right flow | | `elk.edgeRouting` | `POLYLINE` | Bent shafts for overlay arrows | | `elk.spacing.nodeNode` | `56` | Within-layer gap (arrow room) | | `elk.layered.spacing.nodeNodeBetweenLayers` | `80` | Between reactant/product layers | | `elk.layered.spacing.edgeNodeBetweenLayers` | `28` | Inter-layer edge clearance | | `elk.spacing.edgeEdge` | `20` | Parallel edge gap | | `elk.layered.crossingMinimization.strategy` | `LAYER_SWEEP` | Crossing reduction | | `elk.layered.nodePlacement.strategy` | `NETWORK_SIMPLEX` | Y placement | | `elk.layered.crossingMinimization.forceNodeModelOrder` | `false` | Let branches spread |\n\nMerge order: reaction defaults → `elk_options` map → first-class `direction` / `edge_routing` (caller wins).",
      "type": "object",
      "properties": {
        "direction": {
          "description": "Flow axis (`RIGHT` / `LEFT` / `UP` / `DOWN`).",
          "anyOf": [
            {
              "$ref": "#/definitions/ElkDirection"
            },
            {
              "type": "null"
            }
          ]
        },
        "edge_routing": {
          "description": "Shaft routing (`POLYLINE` / `ORTHOGONAL` / `SPLINES`).",
          "anyOf": [
            {
              "$ref": "#/definitions/ElkEdgeRouting"
            },
            {
              "type": "null"
            }
          ]
        },
        "elk_options": {
          "description": "Extra ELK layout options (string values), e.g. spacing overrides.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "MolNode": {
      "description": "Mol node — [`MolOpts`] fields + non-cascading identity / scores / align.",
      "type": "object",
      "properties": {
        "align_to": {
          "description": "Template id string, or `{ \"ref\", \"atom_map\"?, \"min_atoms\"? }`.",
          "anyOf": [
            {
              "$ref": "#/definitions/AlignTo"
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "cxsmiles": {
          "type": [
            "string",
            "null"
          ]
        },
        "halo": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "description": "Caption: [`Label`] (string id, list, or `{id, pos?}` — text-node refs).",
          "anyOf": [
            {
              "$ref": "#/definitions/Label"
            },
            {
              "type": "null"
            }
          ]
        },
        "molfile": {
          "type": [
            "string",
            "null"
          ]
        },
        "opts": {
          "description": "Cascade patches for this node (list or singleton).",
          "anyOf": [
            {
              "$ref": "#/definitions/Opts"
            },
            {
              "type": "null"
            }
          ]
        },
        "scale": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "shade": {
          "description": "Shade **scores** (+ legacy window); window also cascades via [`Opts`].",
          "anyOf": [
            {
              "$ref": "#/definitions/ShadeSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "smiles": {
          "type": [
            "string",
            "null"
          ]
        },
        "star_labels": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": {
          "default": "mol",
          "allOf": [
            {
              "$ref": "#/definitions/MolNodeKind"
            }
          ]
        },
        "weight": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "MolNodeKind": {
      "description": "Discriminator for mol nodes (`\"type\": \"mol\"`).",
      "type": "string",
      "enum": [
        "mol"
      ]
    },
    "Node": {
      "description": "Document **node**: mol, edge, or text.\n\nUntagged so each variant keeps its own `\"type\"` field. - [`DepictSpec::Group`]: mol | text (no edges). - [`DepictSpec::ReactionScheme`]: mol | edge | text.",
      "anyOf": [
        {
          "$ref": "#/definitions/MolNode"
        },
        {
          "$ref": "#/definitions/EdgeNode"
        },
        {
          "$ref": "#/definitions/TextNode"
        }
      ]
    },
    "NodeType": {
      "description": "Document node kinds opts may target (matches wire `\"type\"` discriminants).",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "mol",
            "group"
          ]
        },
        {
          "description": "Multi-mol scheme with edge nodes in `children` (`\"type\": \"reaction_scheme\"`).",
          "type": "string",
          "enum": [
            "reaction_scheme"
          ]
        },
        {
          "description": "Edge / reaction link node (`\"type\": \"edge\"`).",
          "type": "string",
          "enum": [
            "edge"
          ]
        },
        {
          "description": "Text caption / chrome node (`\"type\": \"text\"`).",
          "type": "string",
          "enum": [
            "text"
          ]
        }
      ]
    },
    "Opts": {
      "description": "Cascade bag: singleton patch or list of patches.",
      "anyOf": [
        {
          "$ref": "#/definitions/OptsPatch"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OptsPatch"
          }
        }
      ]
    },
    "OptsPatch": {
      "description": "One cascade rule. Untagged order: typed → for_types → universal.",
      "anyOf": [
        {
          "description": "`{ \"type\": \"mol\", \"weight\": 1.2 }` — discriminated kind.",
          "allOf": [
            {
              "$ref": "#/definitions/TypedOptsPatch"
            }
          ]
        },
        {
          "description": "`{ \"for_types\": [\"mol\",\"group\"], \"color\": \"#111\" }`.",
          "allOf": [
            {
              "$ref": "#/definitions/ForTypesPatch"
            }
          ]
        },
        {
          "description": "`{ \"color\": \"#111\" }` — applies to every kind.",
          "allOf": [
            {
              "$ref": "#/definitions/CommonOpts"
            }
          ]
        }
      ]
    },
    "ShadeSpec": {
      "description": "Per-atom / per-bond colormap scores (+ legacy window fields on the mol).\n\nPrefer putting `colormap` / `vmin` / `vmax` in cascading [`MolOpts::shade`]; values here still apply as local leaf overrides for compat.",
      "type": "object",
      "properties": {
        "atoms": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "bonds": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "colormap": {
          "type": [
            "string",
            "null"
          ]
        },
        "vmax": {
          "default": 1.0,
          "type": "number",
          "format": "double"
        },
        "vmin": {
          "default": 0.0,
          "type": "number",
          "format": "double"
        }
      }
    },
    "ShadeStyle": {
      "description": "Cascading shade window / LUT (not per-atom scores).",
      "type": "object",
      "properties": {
        "colormap": {
          "type": [
            "string",
            "null"
          ]
        },
        "vmax": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "vmin": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "TextNode": {
      "description": "Text **node** — caption / chrome referenced by mols and edges via id.\n\n```json { \"type\": \"text\", \"id\": \"adh\", \"text\": \"ADH\" } ```",
      "type": "object",
      "required": [
        "text",
        "type"
      ],
      "properties": {
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Stable id — required when other nodes [`MolNode::label`] / edge lanes ref it.",
          "type": [
            "string",
            "null"
          ]
        },
        "opts": {
          "anyOf": [
            {
              "$ref": "#/definitions/Opts"
            },
            {
              "type": "null"
            }
          ]
        },
        "scale": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "text": {
          "description": "Display text (markup-capable later).",
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/TextNodeKind"
        }
      }
    },
    "TextNodeKind": {
      "description": "Discriminator for text nodes (`\"type\": \"text\"`).",
      "type": "string",
      "enum": [
        "text"
      ]
    },
    "TypedOptsPatch": {
      "description": "Discriminated opts patch: `{ \"type\": \"mol\"|\"group\"|\"reaction_scheme\"|\"edge\"|\"text\", …opts }`.",
      "oneOf": [
        {
          "description": "Mol cascading paint opts — what a mol leaf consumes from the cascade.\n\n[`MolNode`] carries the same fields at the top level (local leaf opts) plus non-cascading identity keys.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "color": {
              "type": [
                "string",
                "null"
              ]
            },
            "halo": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "scale": {
              "type": [
                "number",
                "null"
              ],
