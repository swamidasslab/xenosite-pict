{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DepictSpec",
  "description": "Declarative document (`mol` or `group` root).",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "align_to": {
          "anyOf": [
            {
              "$ref": "#/definitions/AlignTo"
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "cxsmiles": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "molfile": {
          "type": [
            "string",
            "null"
          ]
        },
        "scale": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "shade": {
          "anyOf": [
            {
              "$ref": "#/definitions/ShadeSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "smiles": {
          "type": [
            "string",
            "null"
          ]
        },
        "star_labels": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": {
          "type": "string",
          "enum": [
            "mol"
          ]
        },
        "weight": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "align": {
          "description": "When true, later children align onto the first (or each `align_to`).",
          "default": false,
          "type": "boolean"
        },
        "children": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/MolNode"
          }
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "group"
          ]
        }
      }
    }
  ],
  "definitions": {
    "AlignTo": {
      "description": "Document align target: id string or `{ \"ref\", \"atom_map\"?, \"min_atoms\"? }`.",
      "anyOf": [
        {
          "description": "Shorthand for `{ \"ref\": \"…\" }`.",
          "type": "string"
        },
        {
          "$ref": "#/definitions/AlignToSpec"
        }
      ]
    },
    "AlignToSpec": {
      "description": "Object form of document ``align_to`` (template ref + EdgePlan-style opts).",
      "type": "object",
      "required": [
        "ref"
      ],
      "properties": {
        "atom_map": {
          "description": "Pairs `(query, template)` vs the template; skips MCS when set.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": [
              {
                "type": "integer",
                "format": "uint32",
                "minimum": 0.0
              },
              {
                "type": "integer",
                "format": "uint32",
                "minimum": 0.0
              }
            ],
            "maxItems": 2,
            "minItems": 2
          }
        },
        "min_atoms": {
          "description": "Override [`crate::edge::MIN_MCS_ATOMS`] when set.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "ref": {
          "description": "Id of the template mol in this group.",
          "type": "string"
        }
      }
    },
    "MolNode": {
      "description": "Mol node — subset of future ``MolNode``.",
      "type": "object",
      "properties": {
        "align_to": {
          "description": "Template id string, or `{ \"ref\", \"atom_map\"?, \"min_atoms\"? }`.",
          "anyOf": [
            {
              "$ref": "#/definitions/AlignTo"
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "cxsmiles": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "molfile": {
          "type": [
            "string",
            "null"
          ]
        },
        "scale": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "shade": {
          "anyOf": [
            {
              "$ref": "#/definitions/ShadeSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "smiles": {
          "type": [
            "string",
            "null"
          ]
        },
        "star_labels": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": {
          "default": "mol",
          "allOf": [
            {
              "$ref": "#/definitions/MolNodeKind"
            }
          ]
        },
        "weight": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "MolNodeKind": {
      "description": "Discriminator for mol nodes (`\"type\": \"mol\"`).",
      "type": "string",
      "enum": [
        "mol"
      ]
    },
    "ShadeSpec": {
      "description": "Per-atom / per-bond colormap scores.",
      "type": "object",
      "properties": {
        "atoms": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "bonds": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "colormap": {
          "type": [
            "string",
            "null"
          ]
        },
        "vmax": {
          "default": 1.0,
          "type": "number",
          "format": "double"
        },
        "vmin": {
          "default": 0.0,
          "type": "number",
          "format": "double"
        }
      }
    }
  }
}
