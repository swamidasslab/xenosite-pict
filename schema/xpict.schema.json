{
  "$defs": {
    "AnnotKind": {
      "description": "How an annotation is drawn.",
      "enum": [
        "callout",
        "box",
        "oval",
        "spline"
      ],
      "title": "AnnotKind",
      "type": "string"
    },
    "AnnotPrefer": {
      "description": "Preferred callout placement; collision grid may pick another free slot.",
      "enum": [
        "auto",
        "left",
        "right",
        "top",
        "bottom"
      ],
      "title": "AnnotPrefer",
      "type": "string"
    },
    "AnnotationSpec": {
      "additionalProperties": false,
      "description": "Molecule annotation with collision-aware label placement.\n\nTargets (use one):\n\n- ``atoms`` \u2014 one atom (callout) or a set (region)\n- ``bonds`` \u2014 bond endpoints as ``[begin, end]`` pairs\n- ``ring`` \u2014 atom indices of a ring (callout at ring center)\n\nKinds:\n\n- ``callout`` \u2014 indicator arrow and/or text next to the target\n- ``box`` / ``oval`` / ``spline`` \u2014 region outline around ``atoms``",
      "properties": {
        "kind": {
          "$ref": "#/$defs/AnnotKind",
          "default": "callout"
        },
        "atoms": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0-based atom indices (target or region)",
          "title": "Atoms"
        },
        "bonds": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0-based atom-index pairs",
          "title": "Bonds"
        },
        "ring": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ordered atom indices of a ring (callout at centroid)",
          "title": "Ring"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Annotation caption (supports light TeX/markdown markup)",
          "title": "Label"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stroke/fill color",
          "title": "Color"
        },
        "arrow": {
          "default": true,
          "description": "Draw indicator arrow for callout annotations",
          "title": "Arrow",
          "type": "boolean"
        },
        "prefer": {
          "$ref": "#/$defs/AnnotPrefer",
          "default": "auto",
          "description": "Preferred callout/label side; grid may choose another free slot"
        }
      },
      "title": "AnnotationSpec",
      "type": "object"
    },
    "DiagramKind": {
      "enum": [
        "single",
        "grid",
        "network",
        "reaction",
        "html"
      ],
      "title": "DiagramKind",
      "type": "string"
    },
    "DiagramSpec": {
      "additionalProperties": false,
      "description": "Multi-molecule composition options (ELK / grid / HTML).",
      "properties": {
        "kind": {
          "$ref": "#/$defs/DiagramKind",
          "default": "single"
        },
        "columns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Grid columns when kind=grid",
          "title": "Columns"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/EdgeSpec"
          },
          "title": "Edges",
          "type": "array"
        },
        "elk_options": {
          "additionalProperties": true,
          "description": "Pass-through ELK layout options (engine-specific support varies)",
          "title": "Elk Options",
          "type": "object"
        },
        "align": {
          "default": false,
          "description": "Align later molecules onto the first. RDKit fixes the matched atoms and redraws the rest when it is installed; otherwise each molecule is depicted on its own and rigidly rotated and translated onto the match.",
          "title": "Align",
          "type": "boolean"
        }
      },
      "title": "DiagramSpec",
      "type": "object"
    },
    "EdgeArrow": {
      "description": "Arrow head / shaft style for diagram edges.",
      "enum": [
        "forward",
        "equilibrium",
        "open",
        "line"
      ],
      "title": "EdgeArrow",
      "type": "string"
    },
    "EdgeSpec": {
      "additionalProperties": false,
      "description": "Edge between molecule nodes in a network / reaction diagram.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional semantic role (e.g. enzyme, inhibits) \u2014 not drawn by default",
          "title": "Role"
        },
        "arrow": {
          "$ref": "#/$defs/EdgeArrow",
          "default": "forward"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stroke/fill color for the arrow",
          "title": "Color"
        },
        "stroke_width": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Shaft stroke width",
          "title": "Stroke Width"
        },
        "dashed": {
          "default": false,
          "description": "Dashed shaft (e.g. hypothetical step)",
          "title": "Dashed",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "EdgeSpec",
      "type": "object"
    },
    "MarkKind": {
      "enum": [
        "atoms",
        "bonds",
        "substructure"
      ],
      "title": "MarkKind",
      "type": "string"
    },
    "MarkSpec": {
      "additionalProperties": false,
      "description": "Legacy publication-style mark (circles / bond strokes / hull).\n\nPrefer :class:`AnnotationSpec` for callouts, region shapes, and labels.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/MarkKind",
          "default": "atoms"
        },
        "atoms": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0-based atom indices to mark",
          "title": "Atoms"
        },
        "bonds": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0-based atom-index pairs for bonds to mark",
          "title": "Bonds"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CSS color for the mark",
          "title": "Color"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "title": "MarkSpec",
      "type": "object"
    },
    "MoleculeSpec": {
      "additionalProperties": false,
      "description": "One molecule in a depiction document.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stable id for diagram edges/nodes",
          "title": "Id"
        },
        "smiles": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SMILES string",
          "title": "Smiles"
        },
        "cxsmiles": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ChemAxon extended SMILES (CXSMILES), including coords/labels when present",
          "title": "Cxsmiles"
        },
        "esmiles": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MolParser E-SMILES (SMILES<sep>EXTENSION); schema hook for Markush",
          "title": "Esmiles"
        },
        "molfile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional MDL molblock",
          "title": "Molfile"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string"
                },
                "pos": {
                  "default": "bottom",
                  "enum": [
                    "bottom",
                    "top",
                    "left",
                    "right"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "text"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Molecule caption. A bare string uses defaults (pos=bottom). A dict with only text is equivalent; other keys override defaults. Legacy field name `title` is accepted as an alias. Text supports light markup: TeX-like symbols (\\alpha \u2192 \u03b1) and bold/italic via **\u2026** / *\u2026* or \\textbf{} / \\textit{}."
        },
        "marks": {
          "items": {
            "$ref": "#/$defs/MarkSpec"
          },
          "title": "Marks",
          "type": "array"
        },
        "annotations": {
          "description": "Callouts, region shapes (box/oval/spline), and labels. Placement uses the molecule collision grid.",
          "items": {
            "$ref": "#/$defs/AnnotationSpec"
          },
          "title": "Annotations",
          "type": "array"
        },
        "shade": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShadeSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bond/backbone color override",
          "title": "Color"
        }
      },
      "title": "MoleculeSpec",
      "type": "object"
    },
    "ShadeSpec": {
      "additionalProperties": false,
      "description": "Continuous per-atom / per-bond scores for colormap shading.",
      "properties": {
        "atoms": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-atom scores (same length as atom count)",
          "title": "Atoms"
        },
        "bonds": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-bond scores",
          "title": "Bonds"
        },
        "colormap": {
          "default": "xenosite",
          "description": "Named colormap",
          "title": "Colormap",
          "type": "string"
        },
        "vmin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vmin"
        },
        "vmax": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vmax"
        }
      },
      "title": "ShadeSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Declarative depiction document.\n\nEngine choice (`backend`) is runtime config on Pict/render \u2014 not part of this document.\nShorthand fields (e.g. molecule labels) are expanded at validation; the library\nthen works only on fully expanded models.",
  "properties": {
    "molecules": {
      "items": {
        "$ref": "#/$defs/MoleculeSpec"
      },
      "minItems": 1,
      "title": "Molecules",
      "type": "array"
    },
    "diagram": {
      "$ref": "#/$defs/DiagramSpec"
    },
    "width": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Preferred SVG width",
      "title": "Width"
    },
    "height": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Preferred SVG height",
      "title": "Height"
    },
    "halo": {
      "default": true,
      "description": "Global white knockout under all ink (bonds, labels, marks, captions, edge labels). On = everything; off = nothing. Halos live on the bottom layer so they never obscure drawn content.",
      "title": "Halo",
      "type": "boolean"
    },
    "meta": {
      "additionalProperties": true,
      "title": "Meta",
      "type": "object"
    }
  },
  "required": [
    "molecules"
  ],
  "title": "PictSpec",
  "type": "object"
}
