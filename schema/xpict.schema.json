{
  "$defs": {
    "MolSpec": {
      "additionalProperties": false,
      "description": "One molecule entry for ``depict`` / single-mol render options.\n\nStructure: pass exactly one of ``smiles``, ``cxsmiles``, ``molfile``, or\n``source`` (alias for any structure string).",
      "properties": {
        "smiles": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SMILES string",
          "title": "Smiles"
        },
        "cxsmiles": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ChemAxon extended SMILES (CXSMILES)",
          "title": "Cxsmiles"
        },
        "molfile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MDL molblock",
          "title": "Molfile"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Structure alias (SMILES / CXSMILES / molfile text)",
          "title": "Source"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional molecule id",
          "title": "Id"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ink color for backbone bonds and atom labels (CSS)",
          "title": "Color"
        },
        "atom_shade": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-atom shade scores (layout encounter order)",
          "title": "Atom Shade"
        },
        "bond_shade": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-bond shade scores (layout encounter order)",
          "title": "Bond Shade"
        },
        "mark_atoms": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Atom indices to circle (publication marks)",
          "title": "Mark Atoms"
        },
        "mark_bonds": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bond endpoint index pairs to mark",
          "title": "Mark Bonds"
        },
        "star_labels": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Labels for ``*`` atoms in encounter order; null/empty \u2192 bare star. When omitted, CXSMILES ``|$\u2026$|`` aliases apply by atom index.",
          "title": "Star Labels"
        },
        "bold_labels": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bold Liberation labels + stem-keyed bond stroke",
          "title": "Bold Labels"
        },
        "align_to": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Index of an earlier molecule in the same ``DepictSpec`` to use as the RDKit alignment template",
          "title": "Align To"
        }
      },
      "title": "MolSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Batch document: ordered mols \u2192 ordered rendered results.",
  "properties": {
    "molecules": {
      "items": {
        "$ref": "#/$defs/MolSpec"
      },
      "title": "Molecules",
      "type": "array"
    }
  },
  "title": "DepictSpec",
  "type": "object"
}
