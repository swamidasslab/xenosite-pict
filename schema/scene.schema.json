{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scene",
  "description": "Full drawable document before SVG/HTML serialization.\n\nPython `contracts.scene.Scene` and JS consumers should mirror this shape (JSON round-trip is the ABI).",
  "type": "object",
  "required": [
    "height",
    "viewports",
    "width"
  ],
  "properties": {
    "halo": {
      "description": "Single document-space unioned knockout under molecule ink.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/Primitive"
      }
    },
    "height": {
      "type": "number",
      "format": "double"
    },
    "overlays": {
      "description": "Document-space primitives (reaction arrows) above viewports.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/Primitive"
      }
    },
    "viewports": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Viewport"
      }
    },
    "width": {
      "type": "number",
      "format": "double"
    }
  },
  "definitions": {
    "Layer": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/LayerName"
        },
        "primitives": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/Primitive"
          }
        }
      }
    },
    "LayerName": {
      "description": "Layer name inside a molecule viewport.",
      "type": "string",
      "enum": [
        "shading",
        "halo",
        "bonds",
        "labels",
        "marks",
        "overlay"
      ]
    },
    "Primitive": {
      "description": "One drawable primitive in SVG space (+Y down).",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "d",
            "kind"
          ],
          "properties": {
            "cls": {
              "type": [
                "string",
                "null"
              ]
            },
            "d": {
              "type": "string"
            },
            "data_text": {
              "description": "Plain label string for ``data-text`` (glyph paths only).",
              "type": [
                "string",
                "null"
              ]
            },
            "fill": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "path"
              ]
            },
            "opacity": {
              "default": 1.0,
              "type": "number",
              "format": "double"
            },
            "stroke": {
              "type": [
                "string",
                "null"
              ]
            },
            "stroke_dasharray": {
              "type": [
                "string",
                "null"
              ]
            },
            "stroke_linecap": {
              "type": [
                "string",
                "null"
              ]
            },
            "stroke_width": {
              "default": 1.5,
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "cx",
            "cy",
            "kind",
            "r"
          ],
          "properties": {
            "cls": {
              "type": [
                "string",
                "null"
              ]
            },
            "cx": {
              "type": "number",
              "format": "double"
            },
            "cy": {
              "type": "number",
              "format": "double"
            },
            "fill": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "circle"
              ]
            },
            "opacity": {
              "default": 1.0,
              "type": "number",
              "format": "double"
            },
            "r": {
              "type": "number",
              "format": "double"
            },
            "stroke": {
              "type": [
                "string",
                "null"
              ]
            },
            "stroke_width": {
              "default": 1.5,
              "type": "number",
              "format": "double"
            }
          }
        },
        {
          "description": "Logical text; serializers outline to glyph paths (Liberation) or emit `<text>` when the host prefers.",
          "type": "object",
          "required": [
            "kind",
            "text",
            "x",
            "y"
          ],
          "properties": {
            "anchor": {
              "default": "middle",
              "allOf": [
                {
                  "$ref": "#/definitions/TextAnchor"
                }
              ]
            },
            "cls": {
              "type": [
                "string",
                "null"
              ]
            },
            "fill": {
              "default": "#000",
              "type": "string"
            },
            "font_size": {
              "default": 12.0,
              "type": "number",
              "format": "double"
            },
            "kind": {
              "type": "string",
              "enum": [
                "text"
              ]
            },
            "text": {
              "type": "string"
            },
            "x": {
              "type": "number",
              "format": "double"
            },
            "y": {
              "type": "number",
              "format": "double"
            }
          }
        }
      ]
    },
    "TextAnchor": {
      "description": "Horizontal text anchor (SVG `text-anchor`).",
      "type": "string",
      "enum": [
        "start",
        "middle",
        "end"
      ]
    },
    "Viewport": {
      "description": "One molecule viewport in a diagram (after ELK/grid placement).",
      "type": "object",
      "required": [
        "height",
        "width"
      ],
      "properties": {
        "height": {
          "type": "number",
          "format": "double"
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "layers": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/Layer"
          }
        },
        "width": {
          "type": "number",
          "format": "double"
        },
        "x": {
          "default": 0.0,
          "type": "number",
          "format": "double"
        },
        "y": {
          "default": 0.0,
          "type": "number",
          "format": "double"
        }
      }
    }
  }
}
