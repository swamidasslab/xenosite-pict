{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EdgePlan",
  "description": "Host callback request.",
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "tasks": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/EdgeTask"
      }
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "definitions": {
    "AlignOpts": {
      "description": "Align this mol onto its parent template.",
      "type": "object",
      "properties": {
        "atom_map": {
          "description": "Pairs `(query_atom, template_atom)`. `None` → edge runs MCS.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": [
              {
                "type": "integer",
                "format": "uint32",
                "minimum": 0.0
              },
              {
                "type": "integer",
                "format": "uint32",
                "minimum": 0.0
              }
            ],
            "maxItems": 2,
            "minItems": 2
          }
        },
        "min_atoms": {
          "description": "Override [`MIN_MCS_ATOMS`] when set.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "EdgeTask": {
      "description": "``type: \"coord_gen\"`` edge task.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "roots": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/definitions/MolTemplate"
              }
            },
            "type": {
              "type": "string",
              "enum": [
                "coord_gen"
              ]
            }
          }
        }
      ]
    },
    "MolTemplate": {
      "description": "One node in a coord_gen forest (root = free layout; children align to parent).",
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "align": {
          "description": "Opts for aligning onto the parent; `None` on roots.",
          "anyOf": [
            {
              "$ref": "#/definitions/AlignOpts"
            },
            {
              "type": "null"
            }
          ]
        },
        "cxsmiles": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Rust-assigned unique id; round-trips to the document node.",
          "type": "string"
        },
        "molfile": {
          "type": [
            "string",
            "null"
          ]
        },
        "smiles": {
          "type": [
            "string",
            "null"
          ]
        },
        "template_for": {
          "description": "Children that use this node as their align template.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/MolTemplate"
          }
        }
      }
    }
  }
}
