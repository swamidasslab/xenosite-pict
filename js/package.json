{
  "name": "@xenosite/xpict",
  "version": "0.8.5",
  "description": "Declarative molecule depiction for publication-quality vector graphics — Rust, Python, or the web (JS/WASM)",
  "type": "module",
  "workspaces": [
    "review"
  ],
  "license": "MIT",
  "author": "S. Joshua Swamidass <swamidass@gmail.com>",
  "homepage": "https://swamidasslab.github.io/xenosite-pict/",
  "bugs": {
    "url": "https://github.com/swamidasslab/xenosite-pict/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swamidasslab/xenosite-pict.git",
    "directory": "js"
  },
  "keywords": [
    "chemistry",
    "molecule",
    "depiction",
    "svg",
    "smiles",
    "wasm",
    "xenosite"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "dist/**/*.wasm",
    "!dist/**/*.smoke.*",
    "README.md"
  ],
  "scripts": {
    "build:wasm": "../scripts/build_bindings.sh wasm",
    "build:ts": "tsc -p tsconfig.json",
    "build:copy-wasm": "bash scripts/copy-wasm.sh",
    "build": "npm run build:wasm && npm run build:ts && npm run build:copy-wasm",
    "check": "tsc -p tsconfig.json --noEmit --strict && tsc -p review/tsconfig.json --noEmit",
    "review": "vite --config review/vite.config.ts --open",
    "review:build": "vite build --config review/vite.config.ts",
    "test:catalog": "tsx review/catalog.smoke.ts",
    "test:visual": "playwright test --config review/playwright.config.ts",
    "test:api": "tsx src/api.smoke.ts && tsx src/align.smoke.ts && tsx src/scheme.smoke.ts && tsx review/catalog.smoke.ts",
    "test": "npm run check && npm run test:api",
    "build:pages": "bash ../scripts/build_pages.sh",
    "prepack": "npm run build:ts && npm run build:copy-wasm"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.0",
    "vite": "^8.3.5",
    "yaml": "^2.9.1"
  }
}
