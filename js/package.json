{
  "name": "@xenosite/xpict",
  "version": "0.6.1",
  "description": "Declarative molecule depiction for publication-quality vector graphics — Rust, Python, or the web (JS/WASM)",
  "type": "module",
  "license": "MIT",
  "author": "S. Joshua Swamidass <swamidass@gmail.com>",
  "homepage": "https://swamidasslab.github.io/xenosite-pict/",
  "bugs": {
    "url": "https://github.com/swamidasslab/xenosite-pict/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swamidasslab/xenosite-pict.git",
    "directory": "js"
  },
  "keywords": [
    "chemistry",
    "molecule",
    "depiction",
    "svg",
    "smiles",
    "wasm",
    "xenosite"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "dist/**/*.wasm",
    "!dist/**/*.smoke.*",
    "README.md"
  ],
  "scripts": {
    "build:wasm": "../scripts/build_bindings.sh wasm",
    "build:ts": "tsc -p tsconfig.json",
    "build:copy-wasm": "bash scripts/copy-wasm.sh",
    "build": "npm run build:wasm && npm run build:ts && npm run build:copy-wasm",
    "check": "tsc -p tsconfig.json --noEmit --strict",
    "test:api": "tsx src/api.smoke.ts && tsx src/align.smoke.ts && tsx src/scheme.smoke.ts",
    "test": "npm run check && npm run test:api",
    "build:pages": "bash ../scripts/build_pages.sh",
    "prepack": "npm run build:ts && npm run build:copy-wasm"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.0"
  }
}
