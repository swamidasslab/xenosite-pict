{
  "name": "@xenosite/xpict",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript + WASM bindings for xpict (shared Rust core + Indigo layout stub)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    }
  },
  "files": [
    "dist",
    "src",
    "src/wasm/*.wasm",
    "src/wasm/*.js",
    "src/wasm/*.d.ts"
  ],
  "scripts": {
    "build:wasm": "../scripts/build_bindings.sh wasm",
    "build": "npm run build:wasm && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:pocs": "tsc --strict --module ES2022 --moduleResolution bundler --target ES2022 --esModuleInterop --skipLibCheck --types node --noEmit pocs/elk_layout.ts",
    "test:native": "tsx src/native.smoke.ts",
    "test": "npm run check && npm run check:pocs && npm run test:native"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "elkjs": "^0.9.3"
  }
}
