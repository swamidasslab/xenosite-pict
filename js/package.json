{
  "name": "@swamidasslab/xpict",
  "version": "0.1.0",
  "description": "TypeScript + WASM bindings for xpict (shared Rust core) — for xenosite.org",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swamidasslab/xenosite-pict.git",
    "directory": "js"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "dist/**/*.wasm",
    "!dist/**/native.smoke.*",
    "!dist/**/api.smoke.*"
  ],
  "scripts": {
    "build:wasm": "../scripts/build_bindings.sh wasm",
    "build:ts": "tsc -p tsconfig.json",
    "build:copy-wasm": "bash scripts/copy-wasm.sh",
    "build": "npm run build:wasm && npm run build:ts && npm run build:copy-wasm",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:pocs": "tsc --strict --module ES2022 --moduleResolution bundler --target ES2022 --esModuleInterop --skipLibCheck --types node --noEmit pocs/elk_layout.ts",
    "test:native": "tsx src/native.smoke.ts",
    "test:api": "tsx src/api.smoke.ts",
    "test": "npm run check && npm run check:pocs && npm run test:native && npm run test:api",
    "prepack": "npm run build:ts && npm run build:copy-wasm"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "elkjs": "^0.9.3"
  },
  "dependencies": {
    "@rdkit/rdkit": "^2026.3.6"
  }
}
